---
// The café shelf: a wide unit, or a narrow one when the column is under 640px. Same games, packed twice.
import Unit from './Unit.astro';
import { NARROW, WIDE } from '../../lib/cafe';
import type { ShelfGame } from '../../lib/shelf';

interface Props { games: readonly ShelfGame[]; casual: readonly string[] }
const { games, casual } = Astro.props;
---

<div class="cafe" role="group" aria-label="The shelf. Each box shows its plays in the table below.">
  <div class="fit">
    <Unit games={games} casual={casual} cm={WIDE} class="wide" />
    <Unit games={games} casual={casual} cm={NARROW} class="narrow" />
  </div>
  <p class="pick meta" aria-live="polite">Point at a box, or tap it, to find it in the table.</p>
</div>

<style>
  .cafe{
    margin:8px 0 18px;padding-top:10px;
    --fr:color-mix(in oklab,var(--paper) 22%,#fff);--post:7px;--board:6px;--clear:36;
    --inner:color-mix(in oklab,var(--paper) 84%,var(--soft));
    --leaf:color-mix(in oklab,#4e7d34 78%,var(--ink2));--pot:color-mix(in oklab,var(--red) 45%,var(--ink2));
  }
  :global([data-ed=night]) .cafe{--fr:color-mix(in oklab,var(--paper) 50%,#d8d2c8);--inner:color-mix(in oklab,var(--paper) 88%,var(--soft))}
  .fit{container:shelf / inline-size}
  .fit :global(.narrow){display:none}
  @container shelf (width < 640px){
    .fit :global(.wide){display:none}
    .fit :global(.narrow){display:block;max-width:460px;margin:0 auto}
  }
  .pick{margin:22px 0 0;min-height:1.4em;font-family:var(--fell);font-style:italic}
</style>
