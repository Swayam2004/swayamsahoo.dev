---
import { COMMANDS } from '../data/commands';
---

<dialog id="palette" class="palette" aria-label="Commands">
  <form method="dialog" class="pal-form">
    <input
      id="pal-filter"
      type="text"
      placeholder="Type a command…"
      autocomplete="off"
      spellcheck="false"
      aria-controls="pal-list"
      aria-label="Filter commands"
    />
    <ul id="pal-list" role="listbox" aria-label="Commands" tabindex="-1" autofocus>
      {COMMANDS.map((c) => (
        <li role="option" aria-selected="false" data-cmd={c.id} tabindex="-1">
          <span class="l">{c.label}</span>
          <span class="h">{c.hint}</span>
          {c.key && <kbd>{c.key}</kbd>}
        </li>
      ))}
    </ul>
    <p class="pal-foot"><span id="pal-status" role="status"></span><span>↑↓ to move · enter to run · esc to close</span></p>
  </form>
</dialog>

<nav class="mnav" aria-label="Mobile">
  <a href="/">Home<small>front page</small></a>
  <a href="/projects/">Projects<small>work</small></a>
  <a href="/resume.pdf" target="_blank" rel="noopener">Resume<small>pdf</small></a>
  <a href="/typing/">Type<small>104 wpm</small></a>
  <button type="button" data-open-palette>More<small>commands</small></button>
</nav>

<style is:global>
  .palette{margin:12vh auto auto;width:min(560px,calc(100vw - 24px));max-height:70vh;border:1px solid var(--rule);background:var(--paper);color:var(--ink);padding:0;box-shadow:0 20px 60px rgba(0,0,0,.35)}
  [data-skin=woodland] .palette,[data-skin=marquise] .palette{border-radius:14px}
  .palette::backdrop{background:rgba(20,12,4,.45);backdrop-filter:blur(2px)}
  .palette[open]{animation:palIn .18s ease-out}
  @keyframes palIn{from{opacity:0;transform:translateY(-8px)}}
  .pal-form{display:flex;flex-direction:column;max-height:70vh}
  #pal-filter{font:16px var(--mono);color:var(--ink);background:transparent;border:0;border-bottom:2px solid var(--rule);padding:14px 16px;outline:none}
  #pal-list{list-style:none;overflow:auto;padding:6px;outline:none}
  #pal-list li{display:grid;grid-template-columns:1fr auto auto;align-items:baseline;gap:12px;padding:9px 12px;cursor:pointer;border-radius:6px}
  #pal-list li[aria-selected=true]{background:var(--panel);outline:1px solid var(--soft)}
  #pal-list li[hidden]{display:none}
  #pal-list .l{font-family:var(--sc);font-size:17px}
  #pal-list .h{font-family:var(--mono);font-size:11.5px;color:var(--muted);text-align:right;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  #pal-list kbd{font-family:var(--mono);font-size:11px;border:1px solid var(--soft);border-bottom-width:2px;padding:0 6px;border-radius:3px;color:var(--ink2)}
  .pal-foot{display:flex;justify-content:space-between;gap:10px;font-family:var(--mono);font-size:11px;color:var(--muted);border-top:1px solid var(--soft);padding:8px 14px}
  #pal-status{color:var(--red)}

  .mnav{display:none;position:fixed;left:0;right:0;bottom:0;background:var(--paper);border-top:2px solid var(--rule);justify-content:space-around;font-family:var(--sc);font-size:14px;padding:8px 0 calc(8px + env(safe-area-inset-bottom));z-index:50}
  .mnav a,.mnav button{all:unset;cursor:pointer;text-align:center;color:var(--ink)}
  .mnav small{display:block;font-family:var(--mono);font-size:10px;color:var(--muted)}
  @media (max-width:959px){
    .mnav{display:flex}
    .palette{margin-top:8vh}
    #pal-list kbd,.pal-foot span:last-child{display:none}
  }
</style>
