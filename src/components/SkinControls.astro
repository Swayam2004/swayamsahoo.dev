---
import { SKINS, SKIN_META } from '../data/skins';
---

<div class="skins">
  <button class="skinbtn" type="button" aria-haspopup="menu" aria-expanded="false" aria-controls="skinmenu">
    {SKINS.map((s) => (
      <span class={`v v-${s}`}>
        <i class={`em em-${s}`} aria-hidden="true" />
        <span class="nm">
          {s} · {SKIN_META[s].game}
        </span>
      </span>
    ))}
    <span aria-hidden="true">▾</span>
    <span class="sr-only">Change skin</span>
  </button>
  <div class="skinmenu" id="skinmenu" role="menu" hidden>
    {SKINS.map((s) => (
      <button type="button" role="menuitemradio" aria-checked="false" data-skin={s}>
        <i class={`em em-${s}`} aria-hidden="true" />
        {SKIN_META[s].label}
        <small>{SKIN_META[s].note}</small>
      </button>
    ))}
  </div>
</div>

<button class="edbtn ed-frontier" type="button" data-for="frontier" aria-label={SKIN_META.frontier.editionLabels.toNight}>
  <svg viewBox="0 0 32 36" aria-hidden="true">
    <circle class="glow" cx="16" cy="22" r="13"></circle>
    <path class="smoke" d="M16 9 q-3 -3 0 -6 q3 -3 0 -6"></path>
    <path d="M11 4h10M16 1v3M12 4c0 3 -3 3 -3 6v1h14v-1c0-3-3-3-3-6" fill="none" stroke="currentColor" stroke-width="1.6"></path>
    <path d="M9 11c-2 4-2 12 0 16h14c2-4 2-12 0-16z" fill="none" stroke="currentColor" stroke-width="1.6"></path>
    <path class="flame" d="M16 16c2.5 3 3 5 3 6.5a3 3 0 0 1-6 0c0-1.5.5-3.5 3-6.5z"></path>
    <path d="M7 27h18v3H7zM10 30h12v3H10z" fill="currentColor"></path>
  </svg>
</button>
<button class="edbtn ed-woodland" type="button" data-for="woodland" aria-label={SKIN_META.woodland.editionLabels.toNight}>
  <svg viewBox="0 0 32 36" aria-hidden="true">
    <circle class="sun" cx="16" cy="5" r="4"></circle>
    <path d="M11 11v2c-3 2-4 5-4 9v6c0 3 2 5 5 5h8c3 0 5-2 5-5v-6c0-4-1-7-4-9v-2" fill="none" stroke="currentColor" stroke-width="1.6"></path>
    <path d="M9 9h14v2.5H9z" fill="currentColor"></path>
    <circle class="bug" cx="13" cy="24" r="1.6"></circle>
    <circle class="bug" cx="19" cy="21" r="1.6"></circle>
    <circle class="bug" cx="17" cy="28" r="1.6"></circle>
  </svg>
</button>
<button class="edbtn ed-marquise" type="button" data-for="marquise" aria-label={SKIN_META.marquise.editionLabels.toNight}>
  <svg viewBox="0 0 32 32" aria-hidden="true">
    <path d="M2 16C7 8 25 8 30 16 25 24 7 24 2 16z" fill="none" stroke="currentColor" stroke-width="1.6"></path>
    <circle class="iris" cx="16" cy="16" r="6.5"></circle>
    <ellipse class="pupil" cx="16" cy="16" rx="4.5" ry="6" fill="#1a0f06"></ellipse>
    <path class="lid" d="M2 16C7 8 25 8 30 16 25 18 7 18 2 16z"></path>
  </svg>
</button>

<style is:global>
  .skins{position:relative}
  .skinbtn{all:unset;cursor:pointer;display:flex;align-items:center;gap:7px;font-family:var(--mono);font-size:11.5px;color:var(--muted);border:1px solid var(--muted);padding:5px 12px 5px 8px;border-radius:999px}
  .skinbtn .v{align-items:center;gap:7px}
  [data-skin=frontier] .skinbtn .v-frontier,[data-skin=woodland] .skinbtn .v-woodland,[data-skin=marquise] .skinbtn .v-marquise{display:inline-flex}
  .skinbtn:hover{color:var(--red);border-color:var(--red)}
  .skinbtn:focus-visible{outline:2px solid var(--red);outline-offset:2px}
  .em{width:16px;height:16px;display:inline-block;background:currentColor;flex:none}
  .em-frontier{-webkit-mask:var(--m-star) center/contain no-repeat;mask:var(--m-star) center/contain no-repeat}
  .em-woodland{-webkit-mask:var(--m-tree) center/contain no-repeat;mask:var(--m-tree) center/contain no-repeat}
  .em-marquise{-webkit-mask:var(--m-paw) center/contain no-repeat;mask:var(--m-paw) center/contain no-repeat}
  .skinmenu{position:absolute;right:0;top:calc(100% + 8px);min-width:270px;background:var(--paper);border:1px solid var(--rule);box-shadow:0 10px 30px rgba(0,0,0,.18);padding:6px;z-index:40;border-radius:10px}
  .skinmenu button{all:unset;cursor:pointer;display:grid;grid-template-columns:20px 1fr;gap:2px 10px;width:100%;box-sizing:border-box;padding:8px 10px;border-radius:7px;font-family:var(--mono);font-size:12.5px;color:var(--ink)}
  .skinmenu button:hover,.skinmenu button:focus-visible,.skinmenu button[aria-checked=true]{background:var(--panel);outline:1px solid var(--soft)}
  .skinmenu .em{grid-row:span 2;width:18px;height:18px;align-self:center;background:var(--red)}
  .skinmenu small{color:var(--muted);font-size:11px}

  .edbtn{all:unset;cursor:pointer;display:none;place-items:center;width:38px;height:38px;border:1px solid var(--muted);border-radius:50%;color:var(--ink);transition:border-color .2s,color .2s;flex:none}
  .edbtn:hover{color:var(--red);border-color:var(--red)}
  .edbtn:focus-visible{outline:2px solid var(--red);outline-offset:2px}
  [data-skin=frontier] .ed-frontier,[data-skin=woodland] .ed-woodland,[data-skin=marquise] .ed-marquise{display:grid}
  .edbtn svg{width:24px;height:26px;overflow:visible}
  /* lantern */
  .ed-frontier .flame{transform-origin:16px 23px;transform:scale(0);transition:transform .35s cubic-bezier(.3,1.6,.5,1);fill:#e8a23a}
  .ed-frontier .glow{opacity:0;transition:opacity .4s;fill:#f3c46a}
  [data-ed=night] .ed-frontier .flame{transform:scale(1);animation:flick 1.6s infinite ease-in-out .35s}
  [data-ed=night] .ed-frontier .glow{opacity:.35}
  .smoke{opacity:0;fill:none;stroke:var(--muted);stroke-width:1.2}
  .puff .smoke{animation:smoke .9s ease-out}
  @keyframes flick{0%,100%{transform:scale(1,1) skewX(0)}30%{transform:scale(.92,1.08) skewX(3deg)}60%{transform:scale(1.04,.94) skewX(-2deg)}}
  @keyframes smoke{0%{opacity:.8;transform:translateY(0)}100%{opacity:0;transform:translateY(-12px) scale(1.4)}}
  /* firefly jar */
  .ed-woodland .bug{fill:#f8e27a;opacity:0;transition:opacity .3s}
  [data-ed=night] .ed-woodland .bug{opacity:1;animation:blink 1.8s infinite}
  [data-ed=night] .ed-woodland .bug:nth-of-type(2){animation-delay:.6s}
  [data-ed=night] .ed-woodland .bug:nth-of-type(3){animation-delay:1.1s}
  .ed-woodland .sun{fill:#e8b04a;transition:transform .4s,opacity .4s;transform-origin:16px 5px}
  [data-ed=night] .ed-woodland .sun{opacity:0;transform:scale(.3)}
  @keyframes blink{0%,100%{opacity:.25}50%{opacity:1}}
  /* cat eye */
  .ed-marquise .pupil{transform-origin:16px 16px;transition:transform .45s cubic-bezier(.3,1.5,.5,1);transform:scaleX(.18)}
  .ed-marquise .iris{fill:#f2b23a;transition:fill .4s}
  [data-ed=night] .ed-marquise .pupil{transform:scaleX(.85)}
  [data-ed=night] .ed-marquise .iris{fill:#ffcf5a;filter:drop-shadow(0 0 3px #ff8a3d)}
  .ed-marquise .lid{transform-origin:16px 8px;transform:scaleY(0);fill:var(--paper)}
  .ed-marquise.blink .lid{animation:lid .35s ease-in-out}
  @keyframes lid{50%{transform:scaleY(1)}}

  @media (max-width:959px){.skinbtn .nm{display:none}}
</style>
