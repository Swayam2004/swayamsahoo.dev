{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "swayamsahoo-dev",
  "compatibility_date": "2026-11-23",
  "routes": [{ "pattern": "swayamsahoo.dev", "custom_domain": true }],
  // the custom domain is the only address
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
